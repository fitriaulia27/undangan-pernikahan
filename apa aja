<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Undangan Pernikahan - Romeo & Juliet</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            black: '#000000',
                            dark: '#0f0f0f',
                            card: '#18181b',
                            border: '#27272a',
                            light: '#f8f9fa',
                            muted: '#a1a1aa'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Cinzel', 'serif'],
                        editorial: ['Cormorant Garamond', 'serif']
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f0f0f;
        }
        ::-webkit-scrollbar-thumb {
            background: #27272a;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3f3f46;
        }

        /* Glassmorphism & custom borders */
        .glass-panel {
            background: rgba(15, 15, 15, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .border-glow {
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
        }
        .border-glow:hover {
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
        }

        /* Vinyl Spin Animation */
        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }
        .paused {
            animation-play-state: paused;
        }

        /* Reveal Animation on Scroll */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Custom Noise Texture Overlay */
        .bg-noise {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
        }
    </style>
</head>
<body class="bg-brand-black text-white font-sans antialiased overflow-hidden selection:bg-white selection:text-black bg-noise" id="body-tag">

    <!-- AUDIO PLAYER (HIDDEN AUDIO ELEMENT) -->
    <audio id="bg-music" loop preload="auto">
        <!-- Royalty-free romantic piano ambient audio stream -->
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-piano-112181.mp3" type="audio/mpeg">
    </audio>

    <!-- FLOATING MUSIC BUTTON -->
    <div id="music-control" class="fixed bottom-6 right-6 z-40 hidden transition-all duration-500 transform translate-y-10 opacity-0">
        <button onclick="toggleMusic()" id="music-btn" class="relative group p-3 bg-black/80 border border-white/20 rounded-full text-white shadow-2xl backdrop-blur-md hover:scale-105 active:scale-95 transition-all flex items-center justify-center" aria-label="Toggle Audio">
            <div id="vinyl-disc" class="w-10 h-10 rounded-full border border-zinc-700 bg-zinc-900 flex items-center justify-center animate-spin-slow paused">
                <div class="w-3 h-3 rounded-full bg-white/20 border border-white/50"></div>
            </div>
            <i id="music-icon" class="fas fa-music absolute text-xs text-white"></i>
        </button>
    </div>

    <!-- NOTIFICATION TOAST -->
    <div id="toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 transform -translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-white text-black px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 border border-zinc-200">
            <i class="fas fa-check-circle text-black text-lg"></i>
            <span id="toast-message" class="text-xs tracking-wider uppercase font-medium">Tersalin ke papan klip</span>
        </div>
    </div>

    <!-- COVER / HERO OVERLAY MODAL -->
    <div id="cover-overlay" class="fixed inset-0 z-50 bg-black flex items-center justify-center p-6 transition-all duration-1000">
        <!-- Background Overlay Image with Grayscale & Dark Blur -->
        <div class="absolute inset-0 z-0 opacity-30 bg-cover bg-center filter grayscale brightness-50" style="background-image: url('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=1920&auto=format&fit=crop');"></div>
        
        <div class="relative z-10 max-w-xl w-full text-center space-y-8 flex flex-col items-center">
            <div class="space-y-3">
                <p class="text-xs uppercase tracking-[0.3em] text-zinc-400 font-light">The Wedding Of</p>
                <h1 class="font-serif text-4xl sm:text-6xl tracking-wider text-white font-normal uppercase">Romeo <span class="font-editorial italic font-normal lowercase text-3xl sm:text-5xl">&</span> Juliet</h1>
                <p class="text-xs tracking-[0.25em] text-zinc-300 font-light">15 . 11 . 2026</p>
            </div>

            <div class="w-12 h-[1px] bg-white/30 my-4"></div>

            <div class="space-y-2 glass-panel p-6 rounded-2xl w-full max-w-md border border-white/10">
                <p class="text-xs tracking-widest text-zinc-400 uppercase">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
                <h2 id="guest-name" class="text-xl font-serif tracking-wide text-white capitalize font-medium">Tamu Undangan</h2>
                <p class="text-[10px] text-zinc-400 italic">Tanpa Mengurangi Rasa Hormat, Kami Mengundang Anda Untuk Hadir Di Acara Pernikahan Kami.</p>
            </div>

            <button onclick="openInvitation()" class="group relative px-8 py-4 overflow-hidden rounded-full border border-white/40 bg-transparent text-white text-xs uppercase tracking-[0.25em] transition-all duration-300 hover:border-white hover:text-black">
                <span class="absolute inset-0 bg-white transition-all duration-300 transform -translate-x-full group-hover:translate-x-0"></span>
                <span class="relative z-10 flex items-center gap-3">
                    <i class="fas fa-envelope-open text-xs"></i> Buka Undangan
                </span>
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="relative z-10 max-w-4xl mx-auto bg-brand-black min-h-screen border-x border-zinc-900 shadow-2xl">

        <!-- HEADER HERO SECTION -->
        <section class="relative h-screen flex flex-col justify-between items-center text-center p-8 border-b border-zinc-900 overflow-hidden">
            <div class="absolute inset-0 z-0 opacity-20 bg-cover bg-center filter grayscale" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1920&auto=format&fit=crop');"></div>
            
            <div class="relative z-10 pt-12 reveal">
                <span class="text-[10px] tracking-[0.4em] uppercase text-zinc-400 block mb-2">Walimatul 'Ursy</span>
                <p class="font-serif tracking-widest text-xs text-zinc-300">UNTUK MENGABDIKAN CINTA</p>
            </div>

            <div class="relative z-10 my-auto reveal">
                <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-normal tracking-tight uppercase leading-tight">
                    Romeo<br>
                    <span class="font-editorial italic font-normal lowercase text-4xl sm:text-6xl lg:text-7xl -my-4 block text-zinc-400">&</span>
                    Juliet
                </h1>
                <p class="mt-6 text-xs sm:text-sm tracking-[0.3em] uppercase text-zinc-400">Minggu, 15 November 2026</p>
            </div>

            <div class="relative z-10 pb-8 reveal">
                <a href="#quote" class="text-zinc-500 hover:text-white transition-colors animate-bounce block">
                    <i class="fas fa-chevron-down text-lg"></i>
                </a>
            </div>
        </section>

        <!-- QUOTE / ISLAMIC VERSE SECTION -->
        <section id="quote" class="py-24 px-6 sm:px-12 text-center border-b border-zinc-900">
            <div class="max-w-2xl mx-auto space-y-6 reveal">
                <i class="fas fa-quote-left text-2xl text-zinc-700"></i>
                <p class="font-editorial text-xl sm:text-2xl italic leading-relaxed text-zinc-300">
                    "Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang."
                </p>
                <p class="text-xs tracking-[0.2em] uppercase text-zinc-400 font-semibold">— QS. Ar-Rum: 21 —</p>
            </div>
        </section>

        <!-- MEMPELAI / GROOM & BRIDE PROFILES -->
        <section class="py-24 px-6 sm:px-12 border-b border-zinc-900">
            <div class="text-center mb-16 reveal">
                <h2 class="font-serif text-3xl sm:text-4xl uppercase tracking-widest">Mempelai</h2>
                <div class="w-8 h-[1px] bg-white/40 mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 sm:gap-16">
                <!-- GROOM -->
                <div class="flex flex-col items-center text-center space-y-6 reveal">
                    <div class="relative w-64 h-80 sm:w-72 sm:h-96 rounded-2xl overflow-hidden border-glow">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop" alt="Romeo Montague" class="w-full h-full object-cover filter grayscale contrast-125 hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="space-y-2">
                        <h3 class="font-serif text-2xl tracking-wide uppercase">Romeo Montague, S.T.</h3>
                        <p class="text-xs tracking-wider text-zinc-400 uppercase">Putra Pertama dari</p>
                        <p class="text-xs text-zinc-300">Bpk. Lord Montague & Ibu Lady Montague</p>
                    </div>
                    <a href="https://instagram.com" target="_blank" class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-zinc-800 text-xs tracking-widest text-zinc-300 hover:bg-white hover:text-black transition-all">
                        <i class="fab fa-instagram text-sm"></i> @romeo.montague
                    </a>
                </div>

                <!-- BRIDE -->
                <div class="flex flex-col items-center text-center space-y-6 reveal">
                    <div class="relative w-64 h-80 sm:w-72 sm:h-96 rounded-2xl overflow-hidden border-glow">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800&auto=format&fit=crop" alt="Juliet Capulet" class="w-full h-full object-cover filter grayscale contrast-125 hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="space-y-2">
                        <h3 class="font-serif text-2xl tracking-wide uppercase">Juliet Capulet, M.Ds.</h3>
                        <p class="text-xs tracking-wider text-zinc-400 uppercase">Putri Kedua dari</p>
                        <p class="text-xs text-zinc-300">Bpk. Lord Capulet & Ibu Lady Capulet</p>
                    </div>
                    <a href="https://instagram.com" target="_blank" class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-zinc-800 text-xs tracking-widest text-zinc-300 hover:bg-white hover:text-black transition-all">
                        <i class="fab fa-instagram text-sm"></i> @juliet.capulet
                    </a>
                </div>
            </div>
        </section>

        <!-- COUNTDOWN TIMER SECTION -->
        <section class="py-20 px-6 sm:px-12 border-b border-zinc-900 bg-brand-dark">
            <div class="text-center mb-12 reveal">
                <h2 class="font-serif text-2xl sm:text-3xl uppercase tracking-widest">Menghitung Hari</h2>
                <p class="text-xs tracking-widest text-zinc-400 mt-2">MENUJU HARI BAHAGIA KAMI</p>
            </div>

            <!-- Countdown Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto text-center reveal">
                <div class="p-6 rounded-xl border border-zinc-800 bg-brand-black">
                    <span id="cd-days" class="font-serif text-4xl sm:text-5xl font-bold block">00</span>
                    <span class="text-[10px] tracking-[0.2em] text-zinc-400 uppercase mt-2 block">Hari</span>
                </div>
                <div class="p-6 rounded-xl border border-zinc-800 bg-brand-black">
                    <span id="cd-hours" class="font-serif text-4xl sm:text-5xl font-bold block">00</span>
                    <span class="text-[10px] tracking-[0.2em] text-zinc-400 uppercase mt-2 block">Jam</span>
                </div>
                <div class="p-6 rounded-xl border border-zinc-800 bg-brand-black">
                    <span id="cd-minutes" class="font-serif text-4xl sm:text-5xl font-bold block">00</span>
                    <span class="text-[10px] tracking-[0.2em] text-zinc-400 uppercase mt-2 block">Menit</span>
                </div>
                <div class="p-6 rounded-xl border border-zinc-800 bg-brand-black">
                    <span id="cd-seconds" class="font-serif text-4xl sm:text-5xl font-bold block">00</span>
                    <span class="text-[10px] tracking-[0.2em] text-zinc-400 uppercase mt-2 block">Detik</span>
                </div>
            </div>
        </section>

        <!-- EVENT DETAILS (AKAD & RESEPSI) -->
        <section class="py-24 px-6 sm:px-12 border-b border-zinc-900">
            <div class="text-center mb-16 reveal">
                <h2 class="font-serif text-3xl sm:text-4xl uppercase tracking-widest">Waktu & Lokasi</h2>
                <div class="w-8 h-[1px] bg-white/40 mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- AKAD NIKAH -->
                <div class="p-8 rounded-2xl border border-zinc-800 bg-brand-dark/50 flex flex-col justify-between space-y-6 text-center border-glow reveal">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center mx-auto text-white">
                            <i class="fas fa-ring text-lg"></i>
                        </div>
                        <h3 class="font-serif text-2xl uppercase tracking-wider">Akad Nikah</h3>
                        <p class="text-xs text-zinc-400 tracking-wider">MINGGU, 15 NOVEMBER 2026</p>
                        <p class="text-sm font-semibold text-white">08.00 WIB - 10.00 WIB</p>
                    </div>

                    <div class="space-y-2 border-t border-zinc-800 pt-6">
                        <p class="font-serif text-lg">Grand Ballroom Hotel Indonesia</p>
                        <p class="text-xs text-zinc-400 leading-relaxed">Jl. M.H. Thamrin No.1, Menteng, Jakarta Pusat, DKI Jakarta</p>
                    </div>

                    <a href="https://maps.google.com" target="_blank" class="w-full py-3 rounded-xl border border-white/20 text-xs tracking-widest uppercase hover:bg-white hover:text-black transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-map-marker-alt"></i> Petunjuk Lokasi
                    </a>
                </div>

                <!-- RESEPSI -->
                <div class="p-8 rounded-2xl border border-zinc-800 bg-brand-dark/50 flex flex-col justify-between space-y-6 text-center border-glow reveal">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center mx-auto text-white">
                            <i class="fas fa-glass-cheers text-lg"></i>
                        </div>
                        <h3 class="font-serif text-2xl uppercase tracking-wider">Resepsi</h3>
                        <p class="text-xs text-zinc-400 tracking-wider">MINGGU, 15 NOVEMBER 2026</p>
                        <p class="text-sm font-semibold text-white">11.00 WIB - 15.00 WIB</p>
                    </div>

                    <div class="space-y-2 border-t border-zinc-800 pt-6">
                        <p class="font-serif text-lg">Grand Ballroom Hotel Indonesia</p>
                        <p class="text-xs text-zinc-400 leading-relaxed">Jl. M.H. Thamrin No.1, Menteng, Jakarta Pusat, DKI Jakarta</p>
                    </div>

                    <a href="https://maps.google.com" target="_blank" class="w-full py-3 rounded-xl border border-white/20 text-xs tracking-widest uppercase hover:bg-white hover:text-black transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-map-marker-alt"></i> Petunjuk Lokasi
                    </a>
                </div>
            </div>
        </section>

        <!-- PREWEDDING PHOTO GALLERY -->
        <section class="py-24 px-6 sm:px-12 border-b border-zinc-900">
            <div class="text-center mb-16 reveal">
                <h2 class="font-serif text-3xl sm:text-4xl uppercase tracking-widest">Galeri Momen</h2>
                <p class="text-xs tracking-widest text-zinc-400 mt-2">KISAH DALAM BINGKAI</p>
                <div class="w-8 h-[1px] bg-white/40 mx-auto mt-4"></div>
            </div>

            <!-- MASONRY / GRID GALLERY -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 reveal">
                <div class="cursor-pointer overflow-hidden rounded-xl border border-zinc-800 group" onclick="openLightbox('https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=1200&auto=format&fit=crop')">
                    <img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=600&auto=format&fit=crop" alt="Gallery 1" class="w-full h-64 sm:h-80 object-cover filter grayscale hover:grayscale-0 hover:scale-110 transition-all duration-700">
                </div>
                <div class="cursor-pointer overflow-hidden rounded-xl border border-zinc-800 group" onclick="openLightbox('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=1200&auto=format&fit=crop')">
                    <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=600&auto=format&fit=crop" alt="Gallery 2" class="w-full h-64 sm:h-80 obj
